<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>R06 Tempo 2x15</name>
  <description>2x15 min @ RPE 7, 3 min jog. — Run: Power = fraction of threshold RUN pace (pace=2 ≈ 10k/threshold reference). Set run threshold pace in TP Zones — not bike FTP. TP Workout Library ZWO import is bike-only; use Workout Builder for run or sync from calendar.</description>
  <sportType>run</sportType>
  <durationType>time</durationType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7200" pace="2">
      <textevent message="WU + strides" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="2">
      <textevent message="Tempo 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.6500" pace="2">
      <textevent message="Jog 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="2">
      <textevent message="Tempo 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7800" pace="2">
      <textevent message="CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
