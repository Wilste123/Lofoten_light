<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>SWIM S02 Teknikk skulder</name>
  <description>Skuldervennlig teknikk. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Swim → convert intensity to % Threshold Pace (T-pace/CSS). Power values are % of swim T-pace (easy ~89%, CSS 100%). Set pool length in Equipment.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="300" Power="0.9000" pace="0">
      <textevent message="300 easy" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.8800" pace="0">
      <textevent message="6x75 drill + 4x50 non-free" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.8900" pace="0">
      <textevent message="200 CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
