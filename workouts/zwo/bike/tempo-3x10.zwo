<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>Tempo 3x10</name>
  <description>Muscular endurance — Power = fraction of bike FTP. Set FTP in TrainingPeaks Settings → Zones.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.5500" pace="0">
      <textevent message="Warm-up" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.8200" pace="0">
      <textevent message="Tempo 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5500" pace="0">
      <textevent message="Easy" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.8200" pace="0">
      <textevent message="Tempo 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5500" pace="0">
      <textevent message="Easy" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.8200" pace="0">
      <textevent message="Tempo 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.4500" pace="0">
      <textevent message="Cool-down" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
