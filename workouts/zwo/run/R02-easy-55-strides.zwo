<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>R02 Easy + strides</name>
  <description>50 min + 6x15s strides. — Run: Power = fraction of threshold RUN pace (pace=2 ≈ 10k/threshold reference). Set run threshold pace in TP Zones — not bike FTP. TP Workout Library ZWO import is bike-only; use Workout Builder for run or sync from calendar.</description>
  <sportType>run</sportType>
  <durationType>time</durationType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7800" pace="2">
      <textevent message="Easy 15" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.7800" pace="2">
      <textevent message="Easy 30" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="1.1200" pace="2">
      <textevent message="6x15s strides / 60s" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.7800" pace="2">
      <textevent message="CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
