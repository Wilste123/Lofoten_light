<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>BR03 Run off bike 60</name>
  <description>Etter 4h sykkel — terreng siste 10 min. — Run: Power = fraction of threshold RUN pace (pace=2 ≈ 10k/threshold reference). Set run threshold pace in TP Zones — not bike FTP. TP Workout Library ZWO import is bike-only; use Workout Builder for run or sync from calendar.</description>
  <sportType>run</sportType>
  <durationType>time</durationType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7800" pace="2">
      <textevent message="Easy 15 flat" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.7800" pace="2">
      <textevent message="Trail 30" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9100" pace="2">
      <textevent message="Hills 10" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.7800" pace="2">
      <textevent message="CD 5" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
