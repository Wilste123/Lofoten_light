      <textevent message="400 oppvarming + 4×50" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1920" Power="0.9300" pace="0">
      <textevent message="3×400 jevn 20 s hvile" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8900" pace="0">
      <textevent message="200 avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
