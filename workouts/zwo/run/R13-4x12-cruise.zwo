<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>LØP R13 4×12 cruise</name>
  <description>Halvmaraton-spesifikk. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Løp → intensitet % terskel-pace (samme %-tall). Power ≈ % av løpsterskel (lett ~78 %, terskel 100 %). Ikke sykkel-FTP på kalender.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7200" pace="0">
      <textevent message="Oppvarming" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="1.0000" pace="0">
      <textevent message="Cruise 12 min #1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.6500" pace="0">
      <textevent message="Jogg 3 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="1.0000" pace="0">
      <textevent message="Cruise 12 min #2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.6500" pace="0">
      <textevent message="Jogg 3 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="1.0000" pace="0">
      <textevent message="Cruise 12 min #3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.6500" pace="0">
      <textevent message="Jogg 3 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="1.0000" pace="0">
      <textevent message="Cruise 12 min #4" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.6500" pace="0">
      <textevent message="Jogg 3 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.7800" pace="0">
      <textevent message="Avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
