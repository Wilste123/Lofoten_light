<workout_file>
  <author>Xtri training coach</author>
  <name>SVØM S06 CSS pyramide</name>
  <description>100–200–300–400–300–200–100 @ CSS. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Svøm → intensitet % T-pace (CSS). Power ≈ % av svøm-T-pace (lett ~89 %, CSS 100 %). Sett bassenglengde under Utstyr.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="600" Power="0.9000" pace="0">
      <textevent message="Oppvarming" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="3480" Power="1.0000" pace="0">
      <textevent message="Pyramidesett 20 s pause mellom" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.8900" pace="0">
      <textevent message="Avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
