<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>LØP R06 Tempo 2×15</name>
  <description>2×15 min @ RPE 7, 3 min jogg. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Løp → intensitet % terskel-pace (samme %-tall). Power ≈ % av løpsterskel (lett ~78 %, terskel 100 %). Ikke sykkel-FTP på kalender.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7200" pace="0">
      <textevent message="Oppvarming + strides" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="0">
      <textevent message="Tempo 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.6500" pace="0">
      <textevent message="Jogg 3 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="0">
      <textevent message="Tempo 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7800" pace="0">
      <textevent message="Avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
