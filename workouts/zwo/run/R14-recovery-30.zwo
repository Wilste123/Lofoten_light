<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>LØP R14 Recovery 30</name>
  <description>Recovery — RPE 3–4. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Løp → intensitet % terskel-pace (samme %-tall). Power ≈ % av løpsterskel (lett ~78 %, terskel 100 %). Ikke sykkel-FTP på kalender.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="1800" Power="0.7800" pace="0">
      <textevent message="Lett 30 min eller powerwalk" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
