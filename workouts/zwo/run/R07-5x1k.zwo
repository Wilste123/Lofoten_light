<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>RUN R07 5x1 km</name>
  <description>5x1 km @ 10k effort. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Run → convert intensity to % Threshold Pace (keep the same % numbers). Power values are already % of run threshold (easy ~78%, threshold 100%).</description>
  <sportType>bike</sportType>
  <tags/>
