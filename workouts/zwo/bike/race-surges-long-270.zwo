<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>Race Surges Long 270</name>
  <description>4.5h Z2 with 5 min surges every 30 min — Power = fraction of bike FTP. Set FTP in TrainingPeaks Settings → Zones.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="1200" Power="0.5500" pace="0">
      <textevent message="Warm-up" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.6800" pace="0">
      <textevent message="Block 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8000" pace="0">
      <textevent message="Surge 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.6800" pace="0">
      <textevent message="Block 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8000" pace="0">
      <textevent message="Surge 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.6800" pace="0">
      <textevent message="Block 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8000" pace="0">
      <textevent message="Surge 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.6800" pace="0">
      <textevent message="Block 4" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8000" pace="0">
      <textevent message="Surge 4" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.6800" pace="0">
      <textevent message="Block 5" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8000" pace="0">
      <textevent message="Surge 5" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.6800" pace="0">
      <textevent message="Block 6" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8000" pace="0">
      <textevent message="Surge 6" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.6800" pace="0">
      <textevent message="Block 7" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8000" pace="0">
      <textevent message="Surge 7" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.4500" pace="0">
      <textevent message="Cool-down" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
