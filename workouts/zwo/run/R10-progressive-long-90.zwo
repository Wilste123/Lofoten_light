<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>RUN R10 Progressive 90</name>
  <description>30+30+20 min build. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Run → convert intensity to % Threshold Pace (keep the same % numbers). Power values are already % of run threshold (easy ~78%, threshold 100%).</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="1800" Power="0.7800" pace="0">
      <textevent message="Z2 30" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.9100" pace="0">
      <textevent message="Mod 30" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="1.0000" pace="0">
      <textevent message="MP-HM 20" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7800" pace="0">
      <textevent message="Easy 10" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
