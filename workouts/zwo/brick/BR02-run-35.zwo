<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>RUN BR02 Run off bike 35</name>
  <description>Etter 3h Z2 sykkel. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Run → convert intensity to % Threshold Pace (keep the same % numbers). Power values are already % of run threshold (easy ~78%, threshold 100%).</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="600" Power="0.7800" pace="0">
      <textevent message="Easy 10" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.7800" pace="0">
      <textevent message="Steady 15 RPE 5-6" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7800" pace="0">
      <textevent message="Easy 10" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
