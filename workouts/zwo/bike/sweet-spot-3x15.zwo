<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>Sweet Spot 3x15</name>
  <description>Sustained sub-threshold — Bike: Power = fraction of FTP. Set bike FTP in TrainingPeaks Settings → Zones; watts are calculated on import.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.5500" pace="0">
      <textevent message="Warm-up" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="0">
      <textevent message="SS 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5000" pace="0">
      <textevent message="Easy" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="0">
      <textevent message="SS 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5000" pace="0">
      <textevent message="Easy" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="0">
      <textevent message="SS 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.4500" pace="0">
      <textevent message="Cool-down" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
