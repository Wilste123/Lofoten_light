<workout_file>
  <author>Xtri training coach</author>
  <name>SWIM S03 Aerob 3x500</name>
  <description>3x500 @ RPE 5-6, 25s pause. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Swim → convert intensity to % Threshold Pace (T-pace/CSS). Power values are % of swim T-pace (easy ~89%, CSS 100%). Set pool length in Equipment.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="600" Power="0.9300" pace="0">
      <textevent message="400 WU + 4x50 build" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="2400" Power="0.9300" pace="0">
      <textevent message="3x500 steady 25s rest" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.9300" pace="0">
      <textevent message="200 CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
