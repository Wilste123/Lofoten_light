<workout_file>
  <author>Xtri training coach</author>
  <name>SVØM S08 Åpent vann</name>
  <description>Åpent vann — siktning ca. hvert 6. tak. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Svøm → intensitet % T-pace (CSS). Power ≈ % av svøm-T-pace (lett ~89 %, CSS 100 %). Sett bassenglengde under Utstyr.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="600" Power="0.9000" pace="0">
      <textevent message="Oppvarming på land/brygge" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="2400" Power="0.9300" pace="0">
      <textevent message="400+800+4×50+400 OWS" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.8900" pace="0">
      <textevent message="Lett avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
