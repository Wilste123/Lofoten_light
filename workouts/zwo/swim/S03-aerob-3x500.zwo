<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>SVØM S03 Aerob 3×500</name>
  <description>3×500 m @ RPE 5–6, 25 s pause. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Svøm → intensitet % T-pace (CSS). Power ≈ % av svøm-T-pace (lett ~89 %, CSS 100 %). Sett bassenglengde under Utstyr.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="600" Power="0.9000" pace="0">
      <textevent message="400 oppvarming + 4×50 oppbygging" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="2400" Power="0.9300" pace="0">
      <textevent message="3×500 jevn 25 s hvile" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.8900" pace="0">
      <textevent message="200 avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
