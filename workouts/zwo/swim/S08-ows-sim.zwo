      <textevent message="Shore warm-up" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="2400" Power="0.9300" pace="0">
      <textevent message="400+800+4x50+400 OWS" timeoffset="0"/>
    </SteadyState>
