<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>SWIM S01 Teknikk A</name>
  <description>Drill + aerob. RPE 3-5. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Swim → convert intensity to % Threshold Pace (T-pace/CSS). Power values are % of swim T-pace (easy ~89%, CSS 100%). Set pool length in Equipment.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="600" Power="0.9000" pace="0">
      <textevent message="WU 200 mix + 4x50 drill" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.8800" pace="0">
      <textevent message="8x50 drill/swim 15s + 4x100 easy 20s" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.8900" pace="0">
      <textevent message="8x25 kick + 100 CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
