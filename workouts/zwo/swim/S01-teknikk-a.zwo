      <textevent message="WU 200 mix + 4x50 drill" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.8800" pace="0">
      <textevent message="8x50 drill/swim 15s + 4x100 easy 20s" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.8900" pace="0">
      <textevent message="8x25 kick + 100 CD" timeoffset="0"/>
    </SteadyState>
  </workout>
