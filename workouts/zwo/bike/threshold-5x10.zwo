<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>Threshold 5x10</name>
  <description>Repeated threshold bouts — Bike: Power = fraction of FTP. Set bike FTP in TrainingPeaks Settings → Zones; watts are calculated on import.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.5500" pace="0">
      <textevent message="Warm-up + 3x30s openers @ 110%" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9800" pace="0">
      <textevent message="Threshold 1 — steady cadence" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5000" pace="0">
      <textevent message="Recovery spin" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9800" pace="0">
      <textevent message="Threshold 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5000" pace="0">
      <textevent message="Recovery" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9800" pace="0">
      <textevent message="Threshold 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5000" pace="0">
      <textevent message="Recovery" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9800" pace="0">
      <textevent message="Threshold 4" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.5000" pace="0">
      <textevent message="Recovery" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9800" pace="0">
      <textevent message="Threshold 5 — hold form" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.4500" pace="0">
      <textevent message="Cool-down" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
