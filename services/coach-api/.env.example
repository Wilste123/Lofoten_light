# Coach API — copy to .env (never commit .env)
#
# === Server-wide (chat / LLM) ===
# Required for real OpenAI replies; empty → stub response in chat_service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
#
# === Database / paths ===
# SQLite (default / local / unit tests):
DATABASE_PATH=../../data/coach.db
# Postgres / Supabase — when set, wins over DATABASE_PATH:
# Prefer Session pooler :5432 or direct db.*.supabase.co — append sslmode=require
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_URL=   # alias for DATABASE_URL
# PGCONNECT_TIMEOUT=10
# DB_STRICT_BOOT=0
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ATHLETES_DATA_DIR=../../data/athletes
# KNOWLEDGE_DIR=../../knowledge
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# === Intervals.icu (per athlete — NOT here) ===
# Do NOT put INTERVALS_API / athlete ID in this .env for the web MVP.
# Each athlete enters Intervals athlete ID + API-nøkkel in the app (Du-fanen).
# Stored in DB athlete_secrets via PUT /v1/athlete/me/intervals.
# Repo scripts (scripts/intervals_*.py) may still use root .env INTERVALS_* for CLI.
#
# === Admin seed (optional) ===
# POST /v1/admin/seed-from-repo with header X-Admin-Seed-Token
# Leave empty to disable (CLI seed is enough for MVP).
ADMIN_SEED_TOKEN=
