<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>RUN R06 Tempo 2x15</name>
  <description>2x15 min @ RPE 7, 3 min jog. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Run → convert intensity to % Threshold Pace (keep the same % numbers). Power values are already % of run threshold (easy ~78%, threshold 100%).</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7200" pace="0">
      <textevent message="WU + strides" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="0">
      <textevent message="Tempo 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.6500" pace="0">
      <textevent message="Jog 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9100" pace="0">
      <textevent message="Tempo 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7800" pace="0">
      <textevent message="CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
