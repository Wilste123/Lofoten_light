<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>Threshold 4x12</name>
  <description>Longer sub-threshold blocks — Bike: Power = fraction of FTP. Set bike FTP in TrainingPeaks Settings → Zones; watts are calculated on import.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.5500" pace="0">
      <textevent message="Warm-up" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.9600" pace="0">
      <textevent message="Block 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="240" Power="0.5000" pace="0">
      <textevent message="Recovery" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.9600" pace="0">
      <textevent message="Block 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="240" Power="0.5000" pace="0">
      <textevent message="Recovery" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.9600" pace="0">
      <textevent message="Block 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="240" Power="0.5000" pace="0">
      <textevent message="Recovery" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.9600" pace="0">
      <textevent message="Block 4" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.4500" pace="0">
      <textevent message="Cool-down" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
