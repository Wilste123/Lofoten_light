<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>LØP BR03 Løp etter sykkel 60</name>
  <description>Etter 4 t sykkel — terreng siste 10 min. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Løp → intensitet % terskel-pace (samme %-tall). Power ≈ % av løpsterskel (lett ~78 %, terskel 100 %). Ikke sykkel-FTP på kalender.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7800" pace="0">
      <textevent message="Lett 15 min flatt" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.7800" pace="0">
      <textevent message="Terreng 30 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9100" pace="0">
      <textevent message="Bakker 10 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.7800" pace="0">
      <textevent message="Avslutning 5 min" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
