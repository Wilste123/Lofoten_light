<workout_file>
  <author>Xtri training coach</author>
  <name>SWIM S09 Recovery swim</name>
  <description>Lett bevegelse RPE 2-4. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Swim → convert intensity to % Threshold Pace (T-pace/CSS). Power values are % of swim T-pace (easy ~89%, CSS 100%). Set pool length in Equipment.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="2100" Power="0.8900" pace="0">
      <textevent message="300 + 6x50 + 4x100 pull + 200 easy" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
