<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>SVØM S05 CSS 10×100</name>
  <description>10×100 @ CSS + 10 s pause. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Svøm → intensitet % T-pace (CSS). Power ≈ % av svøm-T-pace (lett ~89 %, CSS 100 %). Sett bassenglengde under Utstyr.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="720" Power="0.9000" pace="0">
      <textevent message="400 oppvarming + 8×50" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="2400" Power="1.0000" pace="0">
      <textevent message="10×100 @ CSS 10 s hvile" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="480" Power="0.8900" pace="0">
      <textevent message="300 pull avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
