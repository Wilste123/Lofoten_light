# Copy to .env locally — never commit .env
#
# === CLI scripts (scripts/intervals_*.py) ===
# GitHub repo secret name: INTERVALS_API
INTERVALS_API=
# INTERVALS_API_KEY=   # alias, optional
INTERVALS_ATHLETE_ID=0
# Optional: default local time on calendar events
INTERVALS_DEFAULT_START_TIME=07:00
#
# === Coach web MVP (services/coach-api) ===
# OPENAI_* for chat — prefer services/coach-api/.env (see that .env.example).
# Intervals for the app: athlete enters ID + API key in Du-tab (SQLite athlete_secrets),
# not these INTERVALS_* vars.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_PATH=data/coach.db
