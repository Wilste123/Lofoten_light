<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>Endurance 120</name>
  <description>Base aerobic — Power = fraction of bike FTP. Set FTP in TrainingPeaks Settings → Zones.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.5500" pace="0">
      <textevent message="Warm-up + 3x30s fast pedals" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="5400" Power="0.7000" pace="0">
      <textevent message="Z2 — start fueling at 20 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.4500" pace="0">
      <textevent message="Cool-down" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
