<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>LØP BR02 Løp etter sykkel 35</name>
  <description>Etter 3 t sone 2 sykkel. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Løp → intensitet % terskel-pace (samme %-tall). Power ≈ % av løpsterskel (lett ~78 %, terskel 100 %). Ikke sykkel-FTP på kalender.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="600" Power="0.7800" pace="0">
      <textevent message="Lett 10 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.7800" pace="0">
      <textevent message="Steady 15 min RPE 5–6" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7800" pace="0">
      <textevent message="Lett 10 min" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
