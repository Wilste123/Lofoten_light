<workout_file>
  <author>Xtri training coach</author>
  <name>SVØM S02 Teknikk skulder</name>
  <description>Skuldervennlig teknikk. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Svøm → intensitet % T-pace (CSS). Power ≈ % av svøm-T-pace (lett ~89 %, CSS 100 %). Sett bassenglengde under Utstyr.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="300" Power="0.9000" pace="0">
      <textevent message="300 lett" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.8800" pace="0">
      <textevent message="6×75 drill + 4×50 uten crawl" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.8900" pace="0">
      <textevent message="200 avslutning" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
