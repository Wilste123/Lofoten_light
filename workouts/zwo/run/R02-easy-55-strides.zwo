<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>RUN R02 Easy + strides</name>
  <description>50 min + 6x15s strides. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Run → convert intensity to % Threshold Pace (keep the same % numbers). Power values are already % of run threshold (easy ~78%, threshold 100%).</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7800" pace="0">
      <textevent message="Easy 15" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.7800" pace="0">
      <textevent message="Easy 30" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="1.1200" pace="0">
      <textevent message="6x15s strides / 60s" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.7800" pace="0">
      <textevent message="CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
