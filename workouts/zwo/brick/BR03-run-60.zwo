<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>RUN BR03 Run off bike 60</name>
  <description>Etter 4h sykkel — terreng siste 10 min. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Run → convert intensity to % Threshold Pace (keep the same % numbers). Power values are already % of run threshold (easy ~78%, threshold 100%).</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0.7800" pace="0">
      <textevent message="Easy 15 flat" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.7800" pace="0">
      <textevent message="Trail 30" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.9100" pace="0">
      <textevent message="Hills 10" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.7800" pace="0">
      <textevent message="CD 5" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
