<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>SWIM S05 CSS 10x100</name>
  <description>10x100 @ CSS +10s pause. — IMPORT: TP only accepts cycling ZWO — this file is sportType=bike so Library import works. After import: open workout → Build → set sport to Swim → convert intensity to % Threshold Pace (T-pace/CSS). Power values are % of swim T-pace (easy ~89%, CSS 100%). Set pool length in Equipment.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="720" Power="0.9300" pace="0">
      <textevent message="400 WU + 8x50" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="2400" Power="0.9300" pace="0">
      <textevent message="10x100 @ CSS 10s rest" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="480" Power="0.9300" pace="0">
      <textevent message="300 pull CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
