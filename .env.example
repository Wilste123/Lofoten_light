# Copy to .env locally — never commit .env
# GitHub repo secret name: INTERVALS_API
INTERVALS_API=
# INTERVALS_API_KEY=   # alias, optional
INTERVALS_ATHLETE_ID=0
# Optional: default local time on calendar events
INTERVALS_DEFAULT_START_TIME=07:00

