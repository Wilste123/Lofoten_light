<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>LØP BR01 Løp etter sykkel 20</name>
  <description>Etter 90 min sykkel — første 5 min RPE 4. — IMPORT: TP godtar kun sykkel-ZWO — filen er sportType=bike for import. Etter import: åpne økt → Bygg → sett sport til Løp → intensitet % terskel-pace (samme %-tall). Power ≈ % av løpsterskel (lett ~78 %, terskel 100 %). Ikke sykkel-FTP på kalender.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="300" Power="0.7800" pace="0">
      <textevent message="Jelly-bein lett 5 min" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.7800" pace="0">
      <textevent message="Lett 15 min RPE 5" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
