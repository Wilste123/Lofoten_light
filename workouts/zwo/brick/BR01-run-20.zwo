  <tags/>
  <workout>
    <SteadyState Duration="300" Power="0.7800" pace="0">
      <textevent message="Jelly legs easy 5" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.7800" pace="0">
      <textevent message="Easy 15 RPE 5" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
