<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Xtri training coach</author>
  <name>R06 Tempo 2x15</name>
  <description>2x15 min @ RPE 7, 3 min jog.</description>
  <sportType>run</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="900" Power="0" pace="0">
      <textevent message="WU + strides" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0" pace="0">
      <textevent message="Tempo 1" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0" pace="0">
      <textevent message="Jog 3" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0" pace="0">
      <textevent message="Tempo 2" timeoffset="0"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0" pace="0">
      <textevent message="CD" timeoffset="0"/>
    </SteadyState>
  </workout>
</workout_file>
