TRAININGPEAKS_ACCESS_TOKEN=
# TP_BEARER_TOKEN=   # alias
TRAININGPEAKS_ATHLETE_ID=
# TRAININGPEAKS_API_BASE=https://api.sandbox.trainingpeaks.com
